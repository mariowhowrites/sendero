<main class="lg:pl-72">
  <div class="xl:pr-96">
    <div class="px-4 py-10 sm:px-6 lg:px-8 lg:py-6">
      <.live_component
        id={(@current_passage && @current_passage.id) || "new_passage"}
        module={SenderoWeb.PassageLive.FormComponent}
        action={(@current_passage && :edit) || :new}
        story={@story}
        passage={@current_passage}
      />
    </div>
  </div>

  <.live_component module={SenderoWeb.StoryLive.VisualizerComponent} id="story-vizualizer" story={@story} />
</main>

<aside class="fixed inset-y-0 right-0 hidden w-96 overflow-y-auto border-l border-gray-200 px-4 py-6 sm:px-6 lg:px-8 xl:block">
  <h2 class="text-xl font-semibold mb-8"><%= @story.title %></h2>

  <%!-- <div class="flex flex-col gap-4" phx-update="stream" id="passages-index">
    <p class="text-gray-500 only:block hidden">No passages yet</p>
    <%= for {dom_id, passage} <- @streams.passages do %>
      <.link id={dom_id} patch={~p"/stories/#{@story.id}/edit/#{passage.id}"}>
        <%= passage.title %>
      </.link>
    <% end %>
  </div> --%>
  <div class="text-xs font-semibold leading-6 text-gray-400">Passages</div>
  <ul role="list" class="-mx-2 my-2 space-y-1">
    <li class="only:flex hidden group gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-700 hover:bg-gray-50 hover:text-indigo-600">
      No passages yet
    </li>
    <%= for {dom_id, passage} <- @streams.passages do %>
      <li id={dom_id}>
        <.link
          patch={~p"/admin/stories/#{@story.id}/passages/#{passage.id}"}
          class={"group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 #{if @current_passage && @current_passage.id == passage.id, do: "bg-gray-50 text-indigo-600", else: "text-gray-700 hover:text-indigo-600 hover:bg-gray-50"}"}
        >
          <span class="truncate"><%= passage.name %></span>
        </.link>
      </li>
    <% end %>
  </ul>

  <.link
    patch={~p"/admin/stories/#{@story.id}/passages/new"}
    class="bg-blue-500 text-white px-4 py-2 rounded-md"
  >
    New Passage
  </.link>
</aside>
