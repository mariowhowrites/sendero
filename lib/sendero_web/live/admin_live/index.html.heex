<.live_component
  module={SenderoWeb.AdminLive.PrimarySidebar}
  id="admin-primary-sidebar"
  story={@story}
  stories={@stories}
/>

<.main_section>
  <%= case @live_action do %>
    <% :dashboard -> %>
      <h1>Dashboard</h1>
    <% :story_editor -> %>
      <.live_component
        module={SenderoWeb.AdminLive.StoryEditor.Index}
        id="story-editor"
        story={@story}
        stories={@stories}
      />
  <% end %>
</.main_section>
